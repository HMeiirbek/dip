# Environment variables for DIP Frontend

# API Base URL (backend URL)
REACT_APP_API_URL=http://localhost:3000/api/v1
# In production/deploy, set this to the actual backend endpoint, for example:
# REACT_APP_API_URL=https://api.example.com/api/v1

# Socket.io URL (for WebSocket signaling)
REACT_APP_SOCKET_URL=http://localhost:3000

# Optional fallback for CRA proxy when REACT_APP_API_URL / REACT_APP_SOCKET_URL are omitted
REACT_APP_BACKEND_PROTOCOL=http
REACT_APP_BACKEND_PORT=3000

# For access from other devices on LAN: set your PC's LAN IP (run "ipconfig" to find it)
# REACT_APP_API_URL=http://192.168.1.XXX:3000/api/v1
# REACT_APP_SOCKET_URL=http://192.168.1.XXX:3000

# Allow dev server to accept connections from other devices (required for mobile/LAN access)
HOST=0.0.0.0

# Optional WebRTC connectivity settings
# REACT_APP_STUN_URLS=stun:stun.l.google.com:19302
# REACT_APP_TURN_URLS=turns:your-turn.example.com:5349?transport=tcp
# REACT_APP_TURN_USERNAME=turn-user
# REACT_APP_TURN_CREDENTIAL=turn-password
# REACT_APP_ICE_TRANSPORT_POLICY=all
# Use `relay` when you want TURN-only routing for harder NAT environments.
