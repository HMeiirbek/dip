datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ChatType {
  PRIVATE
  GROUP
}

enum PrivacyWriteMode {
  EVERYONE
  CONTACTS_ONLY
  NOBODY
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  password     String
  email        String?  @unique
  phone        String?  @unique
  role         String   @default("user") // user | admin | moderator
  trustScore   Int      @default(0)
  isVerified   Boolean  @default(false)
  name         String?
  avatarUrl    String?
  loginNotifications Boolean @default(true)
  allowMessagesFrom  PrivacyWriteMode @default(EVERYONE)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  callsInitiated Call[] @relation("CallerRelation")
  callsReceived  Call[] @relation("CalleeRelation")
  sessions       Session[]
  reports        Report[]
  notifications  Notification[]
  securityLogs   SecurityLog[]
  sentMessages   Message[]      @relation("MessageSenderRelation")
  receivedMessages Message[]    @relation("MessageReceiverRelation")
  chatMemberships ChatMember[]
  sentChatMessages ChatMessage[] @relation("ChatMessageSender")
  ownedChats      Chat[]         @relation("ChatOwner")
  blockedUsers    UserBlacklist[] @relation("UserBlocks")
  blockedByUsers  UserBlacklist[] @relation("BlockedByUsers")

  supportRequests SupportRequest[]
  contacts        Contact[] @relation("UserContacts")
  inContacts      Contact[] @relation("UserInContacts")
}

model Call {
  id             String   @id @default(uuid())
  callerId       String
  calleeId       String
  callerNumber   String?
  receiverNumber String?
  callTime       DateTime @default(now())
  duration       Int?
  riskScore      Int      @default(0)
  caller         User     @relation("CallerRelation", fields: [callerId], references: [id])
  callee         User     @relation("CalleeRelation", fields: [calleeId], references: [id])
  status         String   @default("pending") // pending | accepted | rejected | active | ended
  startedAt      DateTime?
  endedAt        DateTime?
  expiresAt      DateTime? // deadline for pending -> auto-reject
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  analysis       CallAnalysis[]

  @@index([expiresAt], name: "expiresAt_idx")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceInfo   String?
  ipAddress    String?
  refreshToken String
  createdAt    DateTime @default(now())
  expiresAt    DateTime
}

model CallAnalysis {
  id          String   @id @default(uuid())
  callId      String
  call        Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  mlVersion   String
  confidence  Float
  riskFactors Json
  createdAt   DateTime @default(now())
}

model Blacklist {
  id          String   @id @default(uuid())
  phoneNumber String   @unique
  reason      String?
  source      String   @default("user") // user | admin | system
  createdAt   DateTime @default(now())
}

model Report {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber String
  description String?
  status      String   @default("pending") // pending | approved | rejected
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  message    String
  createdAt  DateTime @default(now())
  sender     User     @relation("MessageSenderRelation", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("MessageReceiverRelation", fields: [receiverId], references: [id], onDelete: Cascade)
}

model Chat {
  id        String   @id @default(uuid())
  type      ChatType
  title     String?
  ownerId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner     User?        @relation("ChatOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members   ChatMember[]
  messages  ChatMessage[]

  @@index([type], name: "chat_type_idx")
  @@index([createdAt], name: "chat_created_at_idx")
}

model ChatMember {
  id                String   @id @default(uuid())
  userId            String
  chatId            String
  joinedAt          DateTime @default(now())
  lastReadMessageId String?
  muted             Boolean  @default(false)

  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat              Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([userId, chatId], name: "chat_member_user_chat_unique")
  @@index([chatId], name: "chat_member_chat_id_idx")
  @@index([userId], name: "chat_member_user_id_idx")
}

model ChatMessage {
  id        String   @id @default(uuid())
  chatId    String
  senderId  String
  content   String
  createdAt DateTime @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  chat      Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender    User @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt], name: "chat_message_chat_created_idx")
  @@index([senderId], name: "chat_message_sender_id_idx")
}

model UserBlacklist {
  id            String   @id @default(uuid())
  userId        String
  blockedUserId String
  createdAt     DateTime @default(now())

  user          User @relation("UserBlocks", fields: [userId], references: [id], onDelete: Cascade)
  blockedUser   User @relation("BlockedByUsers", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, blockedUserId], name: "user_blacklist_user_blocked_unique")
  @@index([userId], name: "user_blacklist_user_id_idx")
  @@index([blockedUserId], name: "user_blacklist_blocked_user_id_idx")
}

model SupportRequest {
  id        String   @id @default(uuid())
  userId    String
  topic     String
  text      String
  status    String   @default("open") // open | in_progress | resolved | closed
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "support_request_user_id_idx")
  @@index([status], name: "support_request_status_idx")
  @@index([createdAt], name: "support_request_created_at_idx")
}

model Contact {
  id            String   @id @default(uuid())
  userId        String
  contactUserId String
  createdAt     DateTime @default(now())

  user          User @relation("UserContacts", fields: [userId], references: [id], onDelete: Cascade)
  contactUser   User @relation("UserInContacts", fields: [contactUserId], references: [id], onDelete: Cascade)

  @@unique([userId, contactUserId], name: "contact_user_contact_unique")
  @@index([userId], name: "contact_user_id_idx")
  @@index([contactUserId], name: "contact_contact_user_id_idx")
}

model SecurityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  device    String?
  action    String
  createdAt DateTime @default(now())
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String   @default("info") // info | warning | error
  message   String
  createdAt DateTime @default(now())
}

model MlModel {
  id       String   @id @default(uuid())
  version  String
  accuracy Float
  isActive Boolean  @default(false)
  loadedAt DateTime @default(now())
}
